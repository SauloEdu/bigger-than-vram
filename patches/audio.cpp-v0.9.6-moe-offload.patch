diff --git a/include/engine/community_models/fish_drama3/state_snapshot.h b/include/engine/community_models/fish_drama3/state_snapshot.h
new file mode 100644
index 0000000..2f0d86f
--- /dev/null
+++ b/include/engine/community_models/fish_drama3/state_snapshot.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <ggml-alloc.h>
+#include <ggml-backend.h>
+#include <ggml.h>
+
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+namespace engine::models::fish_drama3 {
+
+// Device-side copy of a set of state tensors (KV caches, recurrent state), so several
+// takes can share one decode graph: load() before a take's step, save() after it.
+class StateSnapshot {
+public:
+    StateSnapshot(std::vector<ggml_tensor *> live, ggml_backend_t backend, int64_t * steps = nullptr)
+        : live_(std::move(live)), steps_(steps) {
+        context_.reset(ggml_init({(live_.size() + 1) * ggml_tensor_overhead(), nullptr, true}));
+        if (!context_) throw std::runtime_error("cannot allocate Drama 3 state snapshot context");
+        for (const auto * tensor : live_) mirror_.push_back(ggml_dup_tensor(context_.get(), tensor));
+        buffer_.reset(ggml_backend_alloc_ctx_tensors(context_.get(), backend));
+        if (!buffer_) throw std::runtime_error("cannot allocate Drama 3 state snapshot buffer");
+    }
+    void save() {
+        for (size_t i = 0; i < live_.size(); ++i) ggml_backend_tensor_copy(live_[i], mirror_[i]);
+        if (steps_) saved_steps_ = *steps_;
+    }
+    void load() {
+        for (size_t i = 0; i < live_.size(); ++i) ggml_backend_tensor_copy(mirror_[i], live_[i]);
+        if (steps_) *steps_ = saved_steps_;
+    }
+
+private:
+    struct ContextDeleter { void operator()(ggml_context * context) const { ggml_free(context); } };
+    struct BufferDeleter { void operator()(ggml_backend_buffer_t buffer) const { ggml_backend_buffer_free(buffer); } };
+    std::vector<ggml_tensor *> live_, mirror_;
+    int64_t * steps_;
+    int64_t saved_steps_ = 0;
+    std::unique_ptr<ggml_context, ContextDeleter> context_;
+    std::unique_ptr<ggml_backend_buffer, BufferDeleter> buffer_;
+};
+
+}  // namespace engine::models::fish_drama3
