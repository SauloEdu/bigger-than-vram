 namespace engine::moe::detail {
 using core::TensorValue;
 using core::TensorShape;
 using core::wrap_tensor;
 
+namespace {
+// Experimental offload tuning, read from environment variables so any MoE family
+// with disk experts gets it without new options:
+//   AUDIOCPP_MOE_STATS=<csv>     per (group, expert) requests and misses, written at exit
+//   AUDIOCPP_MOE_PREFETCH=0|1|2  1: one batched OS read-ahead for the misses of a layer
+//                                2: also read ahead the next group's previous experts in background
+//   AUDIOCPP_MOE_HOTMAP=<csv>    lines "group;expert;vram|ram": vram experts are never evicted
+//                                while another victim exists; ram experts are read into the OS
+//                                file cache in background (bounded by AUDIOCPP_MOE_WARM_MB)
+using Range = std::pair<const std::byte *, size_t>;
+
+void read_ahead(const std::vector<Range> & ranges) {
+    if (ranges.empty()) return;
+#if defined(_WIN32)
+    struct Entry { void * address; SIZE_T bytes; };
+    using Prefetch = BOOL(WINAPI *)(HANDLE, ULONG_PTR, Entry *, ULONG);
+    static const auto prefetch = reinterpret_cast<Prefetch>(
+        reinterpret_cast<void *>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "PrefetchVirtualMemory")));
+    if (!prefetch) return;
+    std::vector<Entry> entries;
+    entries.reserve(ranges.size());
+    for (const auto & range : ranges) entries.push_back({const_cast<std::byte *>(range.first), range.second});
+    prefetch(GetCurrentProcess(), entries.size(), entries.data(), 0);
+#else
+    const auto page = static_cast<uintptr_t>(4096);
+    for (const auto & range : ranges) {
+        const auto begin = reinterpret_cast<uintptr_t>(range.first) & ~(page - 1);
+        madvise(reinterpret_cast<void *>(begin), reinterpret_cast<uintptr_t>(range.first) + range.second - begin, MADV_WILLNEED);
+    }
+#endif
+}
+
+std::string env_text(const char * name) {
+    const char * value = std::getenv(name);
+    return value ? value : "";
+}
+
+// One background worker; stale predictions are dropped instead of queued.
+class ReadAheadWorker {
+public:
+    ~ReadAheadWorker() {
+        { std::lock_guard<std::mutex> lock(mutex_); stop_ = true; }
+        ready_.notify_all();
+        if (thread_.joinable()) thread_.join();
+    }
+    void post(std::vector<Range> ranges, bool droppable) {
+        if (ranges.empty()) return;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (!thread_.joinable()) thread_ = std::thread([this] { run(); });
+            if (droppable) {
+                const size_t kMaxQueuedPredictions = 2;
+                while (predictions_ >= kMaxQueuedPredictions) { jobs_.pop_front(); --predictions_; }
+                ++predictions_;
+                jobs_.push_back(std::move(ranges));
+            } else {
+                warm_.push_back(std::move(ranges));
+            }
+        }
+        ready_.notify_one();
+    }
+private:
+    void run() {
+        for (;;) {
+            std::vector<Range> job;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                ready_.wait(lock, [this] { return stop_ || !jobs_.empty() || !warm_.empty(); });
+                if (stop_) return;
+                if (!jobs_.empty()) { job = std::move(jobs_.front()); jobs_.pop_front(); --predictions_; }
+                else { job = std::move(warm_.front()); warm_.pop_front(); }
+            }
+            read_ahead(job);
+        }
+    }
+    std::mutex mutex_;
+    std::condition_variable ready_;
+    std::deque<std::vector<Range>> jobs_, warm_;
+    size_t predictions_ = 0;
+    bool stop_ = false;
+    std::thread thread_;
+};
