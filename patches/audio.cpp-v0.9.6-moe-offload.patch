+std::vector<Drama3Generation> Drama3Generator::generate_takes(const std::string & text,
+    const std::vector<Drama3Take> & references, const std::vector<Drama3Take> & history,
+    const Drama3Sampling & sampling, size_t takes) {
+    if (!std::isfinite(sampling.temperature) || sampling.temperature < 0 ||
+        !std::isfinite(sampling.top_p) || sampling.top_p <= 0 || sampling.top_p > 1 ||
+        sampling.top_k <= 0 || sampling.max_frames <= 0) throw runtime::InvalidRequestError("invalid Drama 3 sampling parameters");
+    if (takes < 1) throw runtime::InvalidRequestError("Drama 3 batch_takes must be positive");
+    const auto prompt = build_drama3_prompt(*assets_, tokenizer_, text, references, history, {},
+        static_cast<size_t>(cache_steps_ - 1));
+    const auto max_frames = std::min(sampling.max_frames, cache_steps_ - static_cast<int64_t>(prompt.size()));
+    cached_prefix_.clear();
+    cached_hidden_.clear();
+    // One decode session and one tower; each take keeps its own state snapshot,
+    // swapped in before its step. The shared prompt is prefilled only once.
+    struct Take {
+        std::vector<float> hidden;
+        Drama3Frame current;
+        std::mt19937 random;
+        std::deque<int32_t> recent;
+        std::vector<Drama3Frame> frames;
+        std::unique_ptr<StateSnapshot> backbone_state, tower_cache;
+        bool done = false, reached_limit = false;
+    };
+    auto & decoder = decoder_;
+    decoder->reset(disk_experts_);
+    tower_->reset();
+    std::vector<int32_t> ids;
+    for (const auto & frame : prompt) ids.push_back(frame[0]);
+    auto embeddings = backbone_->token_embedding(ids);
+    tower_->mix_backbone_embeddings(embeddings, prompt);
+    const auto prefill = decoder->prefill_embeddings(embeddings, static_cast<int64_t>(prompt.size()));
+    tower_->prefill(prefill.hidden, prompt);
+    std::vector<Take> state(takes);
+    for (size_t t = 0; t < takes; ++t) {
+        auto & take = state[t];
+        take.hidden = last_hidden(prefill.hidden, assets_->backbone.hidden_size);
+        take.current = prompt.back();
+        take.random.seed(sampling.seed + static_cast<uint32_t>(t));
+        if (takes > 1) {
+            take.backbone_state = decoder->snapshot();
+            take.tower_cache = tower_->snapshot();
+            take.backbone_state->save();
+            take.tower_cache->save();
+        }
+    }
+    SamplerScratch scratch;
+    const auto & config = assets_->tower;
+    for (int64_t step = 0; step < max_frames; ++step) {
+        bool active = false;
+        for (auto & take : state) {
+            if (take.done) continue;
+            if (takes > 1) {
+                take.backbone_state->load();
+                take.tower_cache->load();
+            }
+            auto candidates = backbone_->lm_head(take.hidden);
+            const int32_t first = sample(candidates, sampling.temperature, sampling.top_k, sampling.top_p, take.random, scratch);
+            const int32_t second = sample(candidates, 1.0F, 30, 0.95F, take.random, scratch);
+            const int32_t first_token = first == 0 ? assets_->eos : config.semantic_begin + first - 1;
+            const bool repeats = first != 0 && std::find(take.recent.begin(), take.recent.end(), first_token) != take.recent.end();
+            const int32_t selected = repeats ? second : first;
+            if (selected == 0) { take.done = true; continue; }
+            Drama3Frame next{};
+            next[0] = config.semantic_begin + selected - 1;
+            next[1] = selected - 1;
+            const int64_t position = decoder->valid_steps() - 1;
+            if (device_sampling_) {
+                std::array<float, 9> uniforms{};
+                if (sampling.temperature != 0 && sampling.top_k != 1)
+                    for (auto & uniform : uniforms) uniform = static_cast<float>(std::generate_canonical<double, 53>(take.random));
+                next = tower_->run_frame(take.hidden, take.current, selected - 1, position,
+                    sampling.temperature, sampling.top_k, sampling.top_p, uniforms);
+            } else {
+                const auto shared_input = tower_->shared_input({take.current});
+                auto tower_hidden = take.hidden;
+                for (int64_t layer = 0; layer < config.shared_layers + config.residual_layers; ++layer) {
+                    const int64_t book = layer < config.shared_layers ? 0 : layer - config.shared_layers;
+                    const auto output = tower_->run_layer(layer, tower_hidden, {next[1 + book]}, {1.0F},
+                        layer == 0 ? shared_input : std::vector<float>{}, position);
+                    tower_hidden = output.hidden;
+                    if (layer >= config.shared_layers)
+                        next[2 + book] = sample(output.logits, sampling.temperature, sampling.top_k, sampling.top_p, take.random, scratch);
+                }
+            }
+            if (takes > 1) take.tower_cache->save();
+            take.frames.push_back(next);
+            take.recent.push_back(next[0]);
+            if (take.recent.size() > 16) take.recent.pop_front();
+            if (step + 1 == max_frames) { take.reached_limit = true; take.done = true; continue; }
+            take.current = next;
+            auto embedding = backbone_->token_embedding({take.current[0]});
+            tower_->mix_backbone_embeddings(embedding, {take.current});
+            take.hidden = decoder->run_embedding_step(embedding);
+            if (takes > 1) take.backbone_state->save();
+            active = true;
+        }
+        if (!active) break;
+    }
+    if (disk_experts_) {
+        backbone_->release_prefill_graphs();
+        tower_->release_prefill_graphs();
+    }
+    std::vector<Drama3Generation> results(takes);
+    for (size_t t = 0; t < takes; ++t) {
+        const auto & frames = state[t].frames;
+        if (frames.empty()) throw std::runtime_error("Drama 3 take " + std::to_string(t + 1) + " ended before producing an audio frame");
+        auto & result = results[t];
+        result.reached_limit = state[t].reached_limit;
+        result.codes.codebooks = 10;
+        result.codes.frames = static_cast<int64_t>(frames.size());
+        result.codes.codes.resize(frames.size() * 10);
+        for (int64_t book = 0; book < 10; ++book)
+            for (size_t row = 0; row < frames.size(); ++row) result.codes.codes[book * frames.size() + row] = frames[row][book + 1];
+        result.audio = codec_->decode_codes(result.codes);
+        codec_->release_runtime_graphs();
+    }
+    return results;
+}
+
 }  // namespace engine::models::fish_drama3
